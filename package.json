{
  "name": "markupai-vscode",
  "displayName": "MarkupAI",
  "version": "0.1.0",
  "description": "MarkupAI content agents (style, terminology, and more) for VS Code.",
  "categories": [
    "Linters",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/markupai/vscode-extension.git"
  },
  "license": "Apache-2.0",
  "publisher": "markupai",
  "main": "./out/extension.js",
  "browser": "./out/web/extension.js",
  "scripts": {
    "compile": "node esbuild.mjs",
    "compile:watch": "node esbuild.mjs --watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "lint": "eslint src test",
    "lint:check": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "package": "vsce package --out dist/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "contributes": {
    "commands": [
      {
        "command": "markupai.signIn",
        "title": "MarkupAI: Sign In (set API token)"
      },
      {
        "command": "markupai.signOut",
        "title": "MarkupAI: Sign Out"
      },
      {
        "command": "markupai.scanCurrentFile",
        "title": "MarkupAI: Scan Current File",
        "icon": "$(play)"
      },
      {
        "command": "markupai.clearDiagnostics",
        "title": "MarkupAI: Clear Diagnostics"
      },
      {
        "command": "markupai.refreshAgents",
        "title": "MarkupAI: Refresh Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "markupai.openAgentConfig",
        "title": "MarkupAI: Open Agent Configuration"
      },
      {
        "command": "markupai.openBatchCheck",
        "title": "MarkupAI: Open Batch Check"
      }
    ],
    "configuration": {
      "title": "MarkupAI",
      "properties": {
        "markupai.environment": {
          "type": "string",
          "enum": [
            "default",
            "dev",
            "prod"
          ],
          "enumDescriptions": [
            "Use whichever environment this build was compiled for (prod unless .env MARKUPAI_ENV=dev).",
            "Force api.dev.markup.ai.",
            "Force api.markup.ai."
          ],
          "default": "default",
          "description": "Override the MarkupAI API environment. Leave at 'default' unless you know what you're doing — the build-time default is 'prod' for released builds and 'dev' when compiled with MARKUPAI_ENV=dev."
        },
        "markupai.enabledAgents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Agent slugs to enable in the UI. When empty, all compile-time-enabled agents that exist on the platform are shown."
        },
        "markupai.styleGuideTargetId": {
          "type": "string",
          "default": "",
          "description": "Default target (style guide) ID used by the Style agent."
        },
        "markupai.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "MarkupAI extension log level."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "markupai.scanCurrentFile",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(md|markdown|html|htm|dita|txt|xml|rst)$/"
        }
      ],
      "view/title": [
        {
          "command": "markupai.refreshAgents",
          "when": "view == markupai.agentConfig",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "markupai": [
        {
          "id": "markupai.agentConfig",
          "name": "Agent Configuration",
          "type": "webview"
        },
        {
          "id": "markupai.batchCheck",
          "name": "Batch Check",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markupai",
          "title": "MarkupAI",
          "icon": "$(sparkle)"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-packagejson": "^2.5.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "vscode": "^1.95.0"
  }
}
