# Copy to `.env` at the repo root to flip the build's default environment.
#
# MARKUPAI_ENV=dev   → bundle points at api.dev.markup.ai by default
# MARKUPAI_ENV=prod  → bundle points at api.markup.ai by default
#
# Released builds have no `.env` and therefore default to prod. The
# user can always override at runtime via the `markupai.environment`
# setting.

MARKUPAI_ENV=dev
